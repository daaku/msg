# Copy to .env for development. In production put the values in the file
# named by EnvironmentFile= in the systemd unit. Variables already set in the
# environment win over this file.

# External origin. Gives the passkey RP ID and origin, so changing the host
# name later invalidates every passkey.
# PUBLIC_URL=http://localhost:8080
# PUBLIC_URL=https://chat.example.com

# Page titles, home screen name, passkey RP name.
# APP_NAME=msg

# Holds msg.db, temporary conversion files and the fake bucket. systemd sets
# it through StateDirectory=.
# STATE_DIRECTORY=data

# Username of the bootstrap admin.
# ADMIN_USERNAME=admin

# 1 enables live reload and stack traces on error pages. Never in production.
DEV=1

# S3 compatible bucket. "fake" is a bucket built into the server that keeps
# objects in STATE_DIRECTORY/fakes3, for development only.
S3_ENDPOINT=fake
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=us-east-1
# S3_REGION=auto
# S3_BUCKET=msg
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# true: https://host/bucket/key. false: https://bucket.host/key (AWS S3).
# S3_PATH_STYLE=true

# Signed URL validity. 7d is the most AWS S3, R2 and MinIO accept.
# S3_URL_VALIDITY=7d

# Largest accepted upload. KB, MB, GB, TB are binary (1MB is 1048576 bytes).
# MAX_UPLOAD_SIZE=100MB

# Converted images: webp, avif or jpeg.
# IMAGE_FORMAT=webp

# Long edge caps: 4k, 1440p, 1080p, 720p or 480p. Never upscaled.
# IMAGE_RESOLUTION=4k
# VIDEO_RESOLUTION=1080p

# Converted videos: h264 or av1, in MP4 with AAC audio. av1 does not play on
# devices without AV1 decoding, such as iPhones before the 15 Pro.
# VIDEO_FORMAT=h264

# Listen address. The default is localhost:8080. PORT listens on all
# interfaces and wins over ADDR.
# ADDR=127.0.0.1:8080
# PORT=8080

# Set by systemd socket activation; do not set it by hand. When it is 1 the
# inherited socket is used and PORT and ADDR are ignored.
# LISTEN_FDS=1

# Serve HTTPS directly. Not needed behind a TLS terminating proxy.
# TLS_CERT_FILE=cert.pem
# TLS_KEY_FILE=key.pem
